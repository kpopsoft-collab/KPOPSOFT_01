# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev / agent tooling artifacts
/logs
/.playwright-mcp
.claude/scheduled_tasks.lock

# root-level debug screenshots (not app assets)
/*.png

# 세미나 원본 사진 — 검토 전 원본(55MB, 얼굴·고객사 로고 포함).
# 로컬에만 두고 배포하지 않는다. 최적화·선별본은 public/education/ 에 있다.
/public/세미나 사진/
