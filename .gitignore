# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev / agent tooling artifacts
/logs
/.playwright-mcp
.claude/scheduled_tasks.lock

# root-level debug screenshots (not app assets)
/*.png
/*.jpg
/*.jpeg

# 검토 전 원본 사진 — 얼굴·고객사 로고가 그대로 담겨 있고 용량이 크다.
# 로컬에만 두고 배포하지 않는다. 최적화·선별본은 public/education/ 에 있다.
/public/세미나 사진/
/public/강의 및 세미나 사진/

# 아직 어디에 쓸지 정하지 않은 이미지. 쓰기로 하면 최적화해서 제 위치로 옮긴다.
/public/미정리/

# 포트폴리오 콘텐츠 반영 스크립트가 남기는 DB 백업 (운영 데이터라 커밋 금지)
scripts/.work-content-backup.json
