# KPOPSOFT 환경변수 예시
#
# 이 파일을 `.env.local`로 복사해서 값을 채운다.
#   cp .env.example .env.local
#
# `.env*`는 .gitignore에 걸려 있고 이 예시 파일만 예외로 커밋된다.
# **실제 키를 이 파일에 적지 마라.** 값은 .env.local에만 둔다.
#
# ─────────────────────────────────────────────────────────────────────
# 값이 하나도 없어도 앱은 뜬다. 다만 아래처럼 동작이 달라진다.
#
#   Supabase 미설정 → 어드민이 메모리 목데이터로 돈다(새로고침하면 사라진다).
#                     공개 페이지는 src/lib/education-content.ts 등의 정적
#                     데이터로 폴백한다. 즉 "화면은 멀쩡한데 DB를 안 본다."
#   Cloudflare 미설정 → 문의 알림 메일을 안 보내고 경고 로그만 남긴다.
#                     **문의 저장은 성공하므로 폼은 정상으로 보인다.**
#
# 이 폴백 때문에 **화면이 정상이라는 것은 DB 연동이 된다는 증거가 아니다.**
# ─────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────
# 프로젝트 대시보드 → Project Settings → API 에서 가져온다.
# 이 저장소의 프로젝트 ref는 `.mcp.json`과 `next.config.ts`에 이미 적혀 있다.
#
# ⚠️ 로컬 개발과 운영 사이트가 **같은 Supabase 프로젝트를 공유**한다
#    (scripts/*.cjs 머리말 참고). 여기 값을 넣고 어드민에서 고치면
#    www.kpopsoft.com 에 즉시 반영된다.

# 브라우저까지 노출되는 값이다(NEXT_PUBLIC_). 공개돼도 되는 값만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS를 **전부 우회**한다. 절대 클라이언트로 새지 않게 한다.
# 어드민 CMS 읽기/쓰기와 문의 알림 수신자 조회에 쓴다.
# 이 값이 NEXT_PUBLIC_SUPABASE_URL과 **둘 다** 있어야 어드민이 실제 DB를 본다
# (src/lib/admin/content-data.ts 의 getContentData 분기).
SUPABASE_SERVICE_ROLE_KEY=


# ── 어드민 인증 ──────────────────────────────────────────────────────
# 아직 Supabase Auth 배선 전이라 개발용 우회가 **기본으로 켜져 있다**.
# `process.env.ADMIN_DEV_BYPASS !== "false"` 판정이라, 변수를 안 넣으면 켜진다.
# 켜져 있으면 로그인 없이 /admin 에 들어가진다.
#
# 운영/공유 환경에서는 반드시 "false"로 명시한다. 비워 두면 안 된다.
ADMIN_DEV_BYPASS=false


# ── 문의 알림 메일 (Cloudflare Email Service) ────────────────────────
# 기준: KPO-23 승인 설계 §7. **Resend가 아니다** —
# kpopsoft.com의 NS/MX/SPF가 이미 전부 Cloudflare다.
# 경위: docs/08-decisions/09-inquiry-email-notification/
#
# ⚠️ "선택 사항"은 **로컬 개발 기준**에서만 맞다.
#    운영에서 비어 있으면 문의 알림 기능이 통째로 죽는다.
#    그런데도 폼은 성공 화면을 띄우므로 **아무도 모른 채 지나간다.**
#    실제로 2026-07~08에 그 상태로 두 달을 보냈다(OpenProject WP 258).
#    Vercel Production에는 아래 4개를 **반드시** 채운다.

# Cloudflare API 토큰. 권한은 `Email Sending: Edit`만 준다(최소 권한).
CLOUDFLARE_API_TOKEN=

# Cloudflare 계정 ID.
CLOUDFLARE_ACCOUNT_ID=

# 발신 주소. 도메인이 Cloudflare Email Sending에 온보딩돼 있어야 한다.
#   예: inquiry@kpopsoft.com
INQUIRY_NOTIFICATION_FROM=

# 수신 주소(쉼표 구분). **Cloudflare에서 검증된 주소여야 한다.**
# 검증된 주소로 보내는 메일만 전 플랜 무료다 — 임의 수신자로 넓히면
# Workers 유료 플랜이 필요하다. 주소를 늘리려면 Cloudflare에서 먼저 검증한다.
# admin_users 테이블로 폴백하지 않는다(로그인 권한 ≠ 알림 수신 대상).
INQUIRY_NOTIFICATION_TO=

# 메일 본문의 어드민 상세 링크에 쓴다. 없으면 https://kpopsoft.com 으로 폴백.
NEXT_PUBLIC_SITE_URL=


# ── 개발 도구 (앱은 안 씀) ───────────────────────────────────────────
# Supabase MCP 서버(.mcp.json)가 읽는 값. 마이그레이션 적용·DB 조회에 쓴다.
# 앱 코드는 이 값을 참조하지 않으므로 .env.local이 아니라 셸 환경변수로 둬도 된다.
# 발급: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
