# KPOPSOFT 환경변수 예시
#
# 이 파일을 `.env.local`로 복사해서 값을 채운다.
#   cp .env.example .env.local
#
# `.env*`는 .gitignore에 걸려 있고 이 예시 파일만 예외로 커밋된다.
# **실제 키를 이 파일에 적지 마라.** 값은 .env.local에만 둔다.
#
# ─────────────────────────────────────────────────────────────────────
# 값이 하나도 없어도 앱은 뜬다. 다만 아래처럼 동작이 달라진다.
#
#   DB 미설정      → 어드민이 메모리 목데이터로 돈다(새로고침하면 사라진다).
#                     공개 페이지는 src/lib/education-content.ts 등의 정적
#                     데이터로 폴백한다. 즉 "화면은 멀쩡한데 DB를 안 본다."
#   Cloudflare 미설정 → 문의 알림 메일을 안 보내고 경고 로그만 남긴다.
#                     **문의 저장은 성공하므로 폼은 정상으로 보인다.**
#
# 이 폴백 때문에 **화면이 정상이라는 것은 DB 연동이 된다는 증거가 아니다.**
# ─────────────────────────────────────────────────────────────────────


# ── DB (Vercel Neon) · 파일 (Vercel Blob) ────────────────────────────
# 2026-10 Supabase에서 전환(docs/08-결정기록/10-DB-Neon-Prisma-전환/).
# 직접 쓰지 말고 `vercel link` 후 `vercel env pull .env.local`로 받는다 —
# Marketplace 연동이 아래 값을 Vercel 프로젝트에 자동 등록해 둔다.
#
# ⚠️ 로컬 개발과 운영 사이트가 **같은 DB·Blob 스토어를 공유**한다.
#    여기 값을 넣고 어드민에서 고치면 www.kpopsoft.com 에 즉시 반영된다.

# 앱 런타임(풀링). 이 값이 있어야 어드민·공개 페이지가 실제 DB를 본다.
DATABASE_URL=
# Prisma CLI(마이그레이션)용 직결 주소 — prisma.config.ts.
DATABASE_URL_UNPOOLED=
# 업로드(이미지·강의 번들)와 /course-assets 읽기.
BLOB_READ_WRITE_TOKEN=


# ── 어드민 인증 ──────────────────────────────────────────────────────
# 계정은 admin_users 테이블(scrypt 해시). 만들기·비밀번호 재설정:
#   bunx tsx scripts/admin-user.ts seed            # 아래 두 값으로 첫 계정
#   bunx tsx scripts/admin-user.ts set <아이디>
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 세션 쿠키 서명 키. **32자 이상 필수** — 짧으면 로그인이 안 된다.
#   openssl rand -base64 48
ADMIN_SESSION_SECRET=

# 로컬 개발용 로그인 우회. `!== "false"` 판정이라 비워 두면 켜진다.
# **production 빌드에서는 값과 무관하게 꺼진다**(src/lib/admin/auth.ts).
ADMIN_DEV_BYPASS=false


# ── 문의 알림 메일 (Cloudflare Email Service) ────────────────────────
# 기준: KPO-23 승인 설계 §7. **Resend가 아니다** —
# kpopsoft.com의 NS/MX/SPF가 이미 전부 Cloudflare다.
# 경위: docs/08-결정기록/09-문의-이메일-알림/
#
# ⚠️ "선택 사항"은 **로컬 개발 기준**에서만 맞다.
#    운영에서 비어 있으면 문의 알림 기능이 통째로 죽는다.
#    그런데도 폼은 성공 화면을 띄우므로 **아무도 모른 채 지나간다.**
#    실제로 2026-07~08에 그 상태로 두 달을 보냈다(OpenProject WP 258).
#    Vercel Production에는 아래 4개를 **반드시** 채운다.

# Cloudflare API 토큰. 권한은 `Email Sending: Edit`만 준다(최소 권한).
CLOUDFLARE_API_TOKEN=

# Cloudflare 계정 ID.
CLOUDFLARE_ACCOUNT_ID=

# 발신 주소. 도메인이 Cloudflare Email Sending에 온보딩돼 있어야 한다.
#   예: inquiry@kpopsoft.com
INQUIRY_NOTIFICATION_FROM=

# 수신 주소(쉼표 구분). **Cloudflare에서 검증된 주소여야 한다.**
# 검증된 주소로 보내는 메일만 전 플랜 무료다 — 임의 수신자로 넓히면
# Workers 유료 플랜이 필요하다. 주소를 늘리려면 Cloudflare에서 먼저 검증한다.
# admin_users 테이블로 폴백하지 않는다(로그인 권한 ≠ 알림 수신 대상).
INQUIRY_NOTIFICATION_TO=

# 메일 본문의 어드민 상세 링크에 쓴다. 없으면 https://kpopsoft.com 으로 폴백.
NEXT_PUBLIC_SITE_URL=
