# KPOPSOFT 환경변수 예시
#
# 이 파일을 `.env.local`로 복사해서 값을 채운다.
#   cp .env.example .env.local
#
# `.env*`는 .gitignore에 걸려 있고 이 예시 파일만 예외로 커밋된다.
# **실제 키를 이 파일에 적지 마라.** 값은 .env.local에만 둔다.
#
# ─────────────────────────────────────────────────────────────────────
# 값이 하나도 없어도 앱은 뜬다. 다만 아래처럼 동작이 달라진다.
#
#   Supabase 미설정 → 어드민이 메모리 목데이터로 돈다(새로고침하면 사라진다).
#                     공개 페이지는 src/lib/education-content.ts 등의 정적
#                     데이터로 폴백한다. 즉 "화면은 멀쩡한데 DB를 안 본다."
#   Resend 미설정   → 문의 알림 메일을 안 보내고 콘솔에 로그만 남긴다.
#
# 이 폴백 때문에 **화면이 정상이라는 것은 DB 연동이 된다는 증거가 아니다.**
# ─────────────────────────────────────────────────────────────────────


# ── Supabase ─────────────────────────────────────────────────────────
# 프로젝트 대시보드 → Project Settings → API 에서 가져온다.
# 이 저장소의 프로젝트 ref는 `.mcp.json`과 `next.config.ts`에 이미 적혀 있다.
#
# ⚠️ 로컬 개발과 운영 사이트가 **같은 Supabase 프로젝트를 공유**한다
#    (scripts/*.cjs 머리말 참고). 여기 값을 넣고 어드민에서 고치면
#    www.kpopsoft.com 에 즉시 반영된다.

# 브라우저까지 노출되는 값이다(NEXT_PUBLIC_). 공개돼도 되는 값만 넣는다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. RLS를 **전부 우회**한다. 절대 클라이언트로 새지 않게 한다.
# 어드민 CMS 읽기/쓰기와 문의 알림 수신자 조회에 쓴다.
# 이 값이 NEXT_PUBLIC_SUPABASE_URL과 **둘 다** 있어야 어드민이 실제 DB를 본다
# (src/lib/admin/content-data.ts 의 getContentData 분기).
SUPABASE_SERVICE_ROLE_KEY=


# ── 어드민 인증 ──────────────────────────────────────────────────────
# 아직 Supabase Auth 배선 전이라 개발용 우회가 **기본으로 켜져 있다**.
# `process.env.ADMIN_DEV_BYPASS !== "false"` 판정이라, 변수를 안 넣으면 켜진다.
# 켜져 있으면 로그인 없이 /admin 에 들어가진다.
#
# 운영/공유 환경에서는 반드시 "false"로 명시한다. 비워 두면 안 된다.
ADMIN_DEV_BYPASS=false


# ── 문의 알림 메일 (Resend) ──────────────────────────────────────────
# 전부 선택 사항이다. 없으면 메일을 안 보내고 콘솔 로그만 남긴다
# (src/lib/email.ts — 문의 저장 자체는 성공한다).

# 없으면 로그 전용 모드.
RESEND_API_KEY=

# 검증된 발신자. 미설정 시 Resend 공용 발신자로 폴백한다.
#   예: "KPOPSOFT <noreply@kpopsoft.com>"
RESEND_FROM=

# 수신자 강제 지정(쉼표 구분). 비우면 admin_users 테이블의 이메일 전체로 간다.
# 로컬에서 테스트할 때 본인 주소만 받도록 쓰기 좋다.
INQUIRY_NOTIFY_TO=


# ── 개발 도구 (앱은 안 씀) ───────────────────────────────────────────
# Supabase MCP 서버(.mcp.json)가 읽는 값. 마이그레이션 적용·DB 조회에 쓴다.
# 앱 코드는 이 값을 참조하지 않으므로 .env.local이 아니라 셸 환경변수로 둬도 된다.
# 발급: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
